{
  "name": "mrail-rp-launcher",
  "version": "1.2.1",
  "description": "_[MRAIL]_RP desktop launcher with Gmail-address profile registration",
  "main": "main.js",
  "author": "_[MRAIL]_RP",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.mrail.rp.launcher",
    "productName": "_[MRAIL]_RP Launcher",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "the-project-MRAIL-RP",
        "repo": "the-project-MRAIL-RP"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
